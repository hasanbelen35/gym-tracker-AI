generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// TRAINER ASSINGING TO MEMBER
enum AssignmentStatus {
  UNASSIGNED
  PENDING
  ASSIGNED
}

// Gym
model Gym {
  id        Int      @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String   @unique
  password  String
  qrToken   String   @unique @default(uuid())
  createdAt DateTime @default(now())
  members   Member[]
  sessions  Session[]
  trainers  Trainer[]
}

// Trainer
model Trainer {
  id        Int      @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  gymId     Int
  name      String
  surname   String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id])
  myMembers Member[]
  programs  Program[]

}

// Member
model Member {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  gymId     Int
  name      String
  surname   String
  email     String    @unique
  password  String
  age       Int?
  height    Float?
  weight    Float?
  phone     String?
  trainerId Int?
  assignmentStatus AssignmentStatus @default(UNASSIGNED)
  createdAt DateTime  @default(now())
  gym       Gym       @relation(fields: [gymId], references: [id])
  trainer   Trainer?  @relation(fields: [trainerId], references: [id])
  sessions  Session[]
  programs  Program[]

}

// Session
model Session {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  memberId  Int
  gymId     Int
  checkIn   DateTime  @default(now())
  checkOut  DateTime?
  duration  Int?
  member    Member    @relation(fields: [memberId], references: [id])
  gym       Gym       @relation(fields: [gymId], references: [id])
}

// EXERCISE
model Exercise {
  id               Int      @id @default(autoincrement())
  publicId         String   @unique @default(uuid())
  name             String
  category         String?
  bodyPart         String?
  equipment        String?
  targetMuscle     String?
  instructions     String?  @db.Text 
  instruction_steps Json?
  gifUrl           String?
  workoutExercises WorkoutExercise[]
  createdAt        DateTime @default(now())
}


// Program Type
enum ProgramType {
  WORKOUT
  DIET
}

// Split Types
enum SplitCategory {
  PPL
  UPPER_LOWER
  FULL_BODY
  BRO_SPLIT
  CUSTOM
}

// PROGRAM

model Program {
  id           Int           @id @default(autoincrement())
  publicId     String        @unique @default(uuid())
  memberId     Int
  trainerId    Int
  title        String
  type         ProgramType   @default(WORKOUT)
  splitType    SplitCategory @default(PPL)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  archivedAt   DateTime?     // set when isActive is flipped to false

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer      Trainer       @relation(fields: [trainerId], references: [id])

  days         WorkoutDay[]

  @@index([memberId, type, isActive])
  @@index([archivedAt])
}

model WorkoutDay {
  id          Int               @id @default(autoincrement())
  publicId    String            @unique @default(uuid())
  programId   Int
  dayName     String
  dayOrder    Int
  isRestDay   Boolean           @default(false)

  program     Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
}

model WorkoutExercise {
  id           Int            @id @default(autoincrement())
  publicId     String         @unique @default(uuid())
  dayId        Int
  exerciseId   Int
  orderIndex   Int
  notes        String?        @db.Text

  day          WorkoutDay     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise     Exercise       @relation(fields: [exerciseId], references: [id])
  sets         WorkoutSet[]
}

model WorkoutSet {
  id                Int             @id @default(autoincrement())
  publicId          String          @unique @default(uuid())
  workoutExerciseId Int
  setNumber         Int
  targetReps        String?
  targetWeight      Float?
  rir               Int?

  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
}